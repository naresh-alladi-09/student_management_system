# =====================================================================
# Student Management System - Environment Configuration Template
# =====================================================================

# Backend Django Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# Database Configuration (MySQL / Aiven Remote / Local)
DB_ENGINE=django.db.backends.mysql
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_db_password_here
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=3306

# Frontend Vite Settings
VITE_API_BASE_URL=http://localhost:8000
