# =====================================================================
# Academic Management System - Environment Configuration Template
# Copy this file to '.env' and populate with your environment secrets.
# DO NOT commit real secrets or credentials into version control!
# =====================================================================

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (MySQL / Aiven / Local)
DB_ENGINE=django.db.backends.mysql
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_database_password
DB_HOST=your_mysql_host.example.com
DB_PORT=3306

# Optional: Full Database URL (Overrides separate DB variables if provided)
# DATABASE_URL=mysql://user:password@host:port/dbname
