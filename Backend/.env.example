# =====================================================================
# Academic Management System - Environment Configuration Template
# Copy this file to '.env' and populate with your environment secrets.
# DO NOT commit real secrets or credentials into version control!
# =====================================================================

# ---------------------------------------------------------------------
# 1. CORE DJANGO CONFIGURATION
# ---------------------------------------------------------------------
# Set DEBUG to False in production. In development, set to True.
DEBUG=False

# Cryptographically strong secret key (min 50 chars). Mandatory in production.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Comma-separated list of fully qualified hostnames/domains permitted to serve requests.
# Mandatory when DEBUG=False. Example: api.yourcollege.edu,your-app.onrender.com
ALLOWED_HOSTS=api.yourcollege.edu,your-app.onrender.com

# Time Zone (defaults to Asia/Kolkata)
DJANGO_TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------
# 2. CORS & CSRF CONFIGURATION
# ---------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO trailing slashes)
CORS_ALLOWED_ORIGINS=https://portal.yourcollege.edu,https://your-frontend.vercel.app

# Comma-separated list of origins trusted for CSRF validation (with https://)
CSRF_TRUSTED_ORIGINS=https://portal.yourcollege.edu,https://your-frontend.vercel.app

# ---------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# Option A: Full Connection URL (Takes precedence if set)
# DATABASE_URL=mysql://avnadmin:your_password@mysql-host.example.com:22125/defaultdb

# Option B: Individual Database Parameters
DB_ENGINE=django.db.backends.mysql
AIVEN_DB_NAME=defaultdb
AIVEN_DB_USER=avnadmin
AIVEN_PASSWORD=your_secure_db_password
AIVEN_DB_HOST=mysql-host.example.com
AIVEN_DB_PORT=22125

# ---------------------------------------------------------------------
# 4. HTTPS, SSL & SECURITY HEADERS
# ---------------------------------------------------------------------
# Enforce HTTPS redirect (Set to False only if behind an SSL-terminating reverse proxy)
SECURE_SSL_REDIRECT=True

# Strict Transport Security duration in seconds (defaults to 31536000 = 1 year)
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------
# 5. API RATE LIMITING / THROTTLING
# ---------------------------------------------------------------------
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=300/min

# ---------------------------------------------------------------------
# 6. LOGGING
# ---------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# 7. EMAIL SERVICE CONFIGURATION (Institutional Alerts & Attendance)
# ---------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@yourcollege.edu
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Academic Affairs <notifications@yourcollege.edu>
